MCP_TRANSPORT=http
MOBILITEIT_POLL_INTERVAL_SECONDS=30
MOBILITEIT_MAX_ACTIVE_FEEDS=1
MOBILITEIT_MAX_REQUESTS_PER_MINUTE=60
MCP_HTTP_SESSION_IDLE_TIMEOUT_SECONDS=1800
MCP_HTTP_MAX_SESSIONS=100

# Docker Compose deployment settings; see docs/hosting.md.
MCP_DOMAIN=mcp.example.org
MCP_HTTP_ALLOWED_HOSTS=localhost,127.0.0.1,mcp.example.org
